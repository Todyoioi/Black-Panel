-- UNIVERSAL NPC PANEL - ROBLOX STUDIO
-- LocalScript em StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local Config = {
    ESP = true,
    Names = true,
    Distance = true,
    Skeleton = true,
    TeamCheck = true,
    AimAssist = false,
    AimRadius = 250,
    Smoothness = 0.18
}

local GREEN = Color3.fromRGB(0, 255, 130)
local RED = Color3.fromRGB(255, 65, 75)
local PURPLE = Color3.fromRGB(155, 90, 255)

local tracked = {}

local function isNPC(model)
    if not model:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(model) then return false end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local head = model:FindFirstChild("Head")
    local root = model:FindFirstChild("HumanoidRootPart")

    return humanoid and humanoid.Health > 0 and head and root
end

local function isAlly(model)
    if model:GetAttribute("IsAlly") == true then
        return true
    end

    if not Config.TeamCheck then return false end

    local npcTeam = model:GetAttribute("TeamName")
    local playerTeam = player.Team and player.Team.Name
        or player:GetAttribute("TeamName")

    return npcTeam ~= nil
        and playerTeam ~= nil
        and npcTeam == playerTeam
end

local function getColor(model)
    return isAlly(model) and GREEN or RED
end

local function createESP(model)
    if tracked[model] or not isNPC(model) then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "UniversalNPC_ESP"
    highlight.Adornee = model
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 0.75
    highlight.Parent = model

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "UniversalNPC_Info"
    billboard.Adornee = model:FindFirstChild("Head")
    billboard.Size = UDim2.fromOffset(180, 45)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = model

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextStrokeTransparency = 0.2
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.Parent = billboard

    tracked[model] = {
        Highlight = highlight,
        Billboard = billboard,
        Label = label
    }

    -- Esqueleto compatível com R6 e R15
    local folder = Instance.new("Folder")
    folder.Name = "UniversalNPC_Skeleton"
    folder.Parent = model

    local connections = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"},
        {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"},
        {"RightUpperArm", "RightLowerArm"},
        {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"},
        {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"},
        {"LowerTorso", "RightUpperLeg"},
        {"RightUpperLeg", "RightLowerLeg"},
        {"RightLowerLeg", "RightFoot"},
        {"Head", "Torso"},
        {"Torso", "Left Arm"},
        {"Torso", "Right Arm"},
        {"Torso", "Left Leg"},
        {"Torso", "Right Leg"}
    }

    for _, pair in ipairs(connections) do
        local a = model:FindFirstChild(pair[1])
        local b = model:FindFirstChild(pair[2])

        if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
            local att0 = Instance.new("Attachment")
            att0.Parent = a

            local att1 = Instance.new("Attachment")
            att1.Parent = b

            local beam = Instance.new("Beam")
            beam.Attachment0 = att0
            beam.Attachment1 = att1
            beam.Width0 = 0.035
            beam.Width1 = 0.035
            beam.FaceCamera = true
            beam.Parent = folder
        end
    end
end

local function removeESP(model)
    local data = tracked[model]
    if not data then return end

    if data.Highlight then data.Highlight:Destroy() end
    if data.Billboard then data.Billboard:Destroy() end

    local skeleton = model:FindFirstChild("UniversalNPC_Skeleton")
    if skeleton then skeleton:Destroy() end

    tracked[model] = nil
end

-- Interface
local gui = Instance.new("ScreenGui")
gui.Name = "UniversalNPCPanel"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local main = Instance.new("Frame")
main.Size = UDim2.fromOffset(280, 370)
main.Position = UDim2.new(0, 25, 0.5, -185)
main.BackgroundColor3 = Color3.fromRGB(17, 17, 26)
main.BorderSizePixel = 0
main.Active = true
main.Parent = gui

Instance.new("UICorner", main).CornerRadius = UDim.new(0, 12)

local outline = Instance.new("UIStroke")
outline.Color = PURPLE
outline.Thickness = 2
outline.Parent = main

local header = Instance.new("TextButton")
header.Size = UDim2.new(1, 0, 0, 48)
header.BackgroundColor3 = Color3.fromRGB(35, 27, 52)
header.Text = "UNIVERSAL NPC PANEL"
header.TextColor3 = Color3.new(1, 1, 1)
header.Font = Enum.Font.GothamBold
header.TextSize = 15
header.Parent = main

Instance.new("UICorner", header).CornerRadius = UDim.new(0, 12)

-- Arrastar painel
do
    local dragging = false
    local startPosition
    local startMouse

    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            startMouse = input.Position
            startPosition = main.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - startMouse
            main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

local content = Instance.new("Frame")
content.Position = UDim2.fromOffset(12, 60)
content.Size = UDim2.new(1, -24, 1, -70)
content.BackgroundTransparency = 1
content.Parent = main

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 8)
layout.Parent = content

local function makeButton(name, key)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 38)
    button.BackgroundColor3 = Color3.fromRGB(43, 36, 58)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamSemibold
    button.TextSize = 13
    button.Parent = content

    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)

    local function refresh()
        button.Text = name .. ": " .. (Config[key] and "ON" or "OFF")
        button.BackgroundColor3 = Config[key]
            and Color3.fromRGB(35, 100, 70)
            or Color3.fromRGB(43, 36, 58)
    end

    button.MouseButton1Click:Connect(function()
        Config[key] = not Config[key]
        refresh()
    end)

    refresh()
end

makeButton("ESP", "ESP")
makeButton("Nomes", "Names")
makeButton("Distância", "Distance")
makeButton("Esqueleto", "Skeleton")
makeButton("Team Check", "TeamCheck")
makeButton("Aim Assist NPC", "AimAssist")

local close = Instance.new("TextButton")
close.Size = UDim2.new(1, 0, 0, 38)
close.BackgroundColor3 = Color3.fromRGB(120, 40, 55)
close.Text = "FECHAR PAINEL"
close.TextColor3 = Color3.new(1, 1, 1)
close.Font = Enum.Font.GothamBold
close.TextSize = 13
close.Parent = content
Instance.new("UICorner", close).CornerRadius = UDim.new(0, 7)

close.MouseButton1Click:Connect(function()
    main.Visible = false
end)

UIS.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.G then
        main.Visible = not main.Visible
    end
end)

-- Detecta NPCs novos automaticamente
local function scan()
    for _, object in ipairs(Workspace:GetDescendants()) do
        if isNPC(object) then
            createESP(object)
        end
    end

    for model in pairs(tracked) do
        if not model.Parent or not isNPC(model) then
            removeESP(model)
        end
    end
end

Workspace.DescendantAdded:Connect(function(object)
    if object:IsA("Humanoid") then
        task.delay(0.5, function()
            local model = object.Parent
            if model and isNPC(model) then
                createESP(model)
            end
        end)
    end
end)

-- Atualização
RunService.RenderStepped:Connect(function()
    for model, data in pairs(tracked) do
        if model.Parent then
            local color = getColor(model)

            data.Highlight.Enabled = Config.ESP
            data.Highlight.FillColor = color
            data.Highlight.OutlineColor = color

            data.Billboard.Enabled = Config.Names or Config.Distance

            local text = Config.Names and model.Name or ""

            if Config.Distance and player.Character then
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                local npcRoot = model:FindFirstChild("HumanoidRootPart")

                if root and npcRoot then
                    local distance = (root.Position - npcRoot.Position).Magnitude
                    text = text .. "\n" .. math.floor(distance) .. " studs"
                end
            end

            data.Label.Text = text
            data.Label.TextColor3 = color

            local skeleton = model:FindFirstChild("UniversalNPC_Skeleton")
            if skeleton then
                for _, beam in ipairs(skeleton:GetChildren()) do
                    if beam:IsA("Beam") then
                        beam.Enabled = Config.Skeleton
                        beam.Color = ColorSequence.new(color)
                    end
                end
            end
        end
    end

    -- Aim Assist exclusivo para NPCs
    if Config.AimAssist then
        local bestTarget
        local bestDistance = Config.AimRadius
        local center = camera.ViewportSize / 2

        for model in pairs(tracked) do
            if model.Parent and not isAlly(model) then
                local head = model:FindFirstChild("Head")
                local humanoid = model:FindFirstChildOfClass("Humanoid")

                if head and humanoid and humanoid.Health > 0 then
                    local pos, visible = camera:WorldToViewportPoint(head.Position)

                    if visible then
                        local distance = (
                            Vector2.new(pos.X, pos.Y) - center
                        ).Magnitude

                        if distance < bestDistance then
                            bestDistance = distance
                            bestTarget = head
                        end
                    end
                end
            end
        end

        if bestTarget then
            local target = CFrame.lookAt(camera.CFrame.Position, bestTarget.Position)
            camera.CFrame = camera.CFrame:Lerp(target, Config.Smoothness)
        end
    end
end)

task.spawn(function()
    while gui.Parent do
        scan()
        task.wait(2)
    end
end)

print("Universal NPC Panel carregado! Pressione G para abrir ou fechar.")
